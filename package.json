{
  "name": "@oreoui/doodle-icons",
  "version": "0.1.0",
  "description": "152 hand-drawn icons that never sit still — every stroke draws itself, then keeps boiling like a Saturday-morning cartoon.",
  "license": "MIT",
  "author": "Nicole Tang",
  "homepage": "https://oreoui.com/doodle-icons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicoletangnan/doodle-icons.git"
  },
  "bugs": "https://github.com/nicoletangnan/doodle-icons/issues",
  "keywords": [
    "icons",
    "svg-icons",
    "react-icons",
    "hand-drawn",
    "doodle",
    "animated-icons",
    "sketch",
    "react",
    "svg"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./icons/*": "./icons/*",
    "./icons-animated/*": "./icons-animated/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "icons",
    "icons-animated"
  ],
  "scripts": {
    "build:svg": "node --experimental-strip-types scripts/build-svgs.mjs",
    "build": "npm run build:svg && npm run build:preview && tsup",
    "prepublishOnly": "npm run build",
    "build:preview": "node --experimental-strip-types scripts/build-preview.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19.2.4",
    "svg-path-properties": "^1.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
